# Default stays on the Jitsi demo provider until dedicated conferencing is configured.
VITE_MEETING_ENGINE=jitsi
VITE_JITSI_DOMAIN=meet.jit.si

# Change VITE_MEETING_ENGINE=livekit only after configuring all 4 server-side values.
# These must NOT have the VITE_ prefix (which would expose private keys to browsers).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
KYNETRA_HOST_SECRET=

# Persistent accounts/scheduled meetings require Supabase configured and migrations applied.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=  # optional legacy alternative to publishable key
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY= # legacy alternative
